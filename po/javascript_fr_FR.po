#: taguette/static/js/project/intro.js:10
msgid ""
"Bienvenue sur LibreQDA, un logiciel d'analyse qualitative développé en "
"code source libre ouvert par la Plateforme en humanités numériques de "
"l'Université de Sherbrooke."
msgstr ""

#: taguette/static/js/project/intro.js:11
msgid ""
"<p>Visitez notre dépôt de code <a href=\"https://gitlab.com/bin-"
"cirst/libreqda/libre-qda\" target=\"_blank\">Gitlab</a></p>"
msgstr ""

#: taguette/static/js/project/intro.js:15
msgid "<p>Pour consulter la documentation.</p>"
msgstr ""

#: taguette/static/js/project/intro.js:20
msgid "<p>Un projet tutoriel a été ajouté à votre espace personnel.</p>"
msgstr ""

#: taguette/static/js/project/intro.js:27
#: taguette/static/js/project/intro.js:172
msgid "Next"
msgstr ""

#: taguette/static/js/project/intro.js:28
