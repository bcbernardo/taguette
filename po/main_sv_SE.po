#: taguette/main.py:284
msgid "Port number on which to listen"
msgstr "Portnummer att lyssna på"

#: taguette/main.py:286
msgid "Address to bind on"
msgstr "Adress att binda på"

#: taguette/main.py:288
msgid "Open web browser to the application"
msgstr "Öppna webbläsaren till applikationen"

#: taguette/main.py:290
msgid "Don't open the web browser"
msgstr "Öppna inte webbläsaren"

#: taguette/main.py:295
#, python-format
msgid ""
"Database location or connection string, for example 'project.db' or "
"'postgresql://me:pw@localhost/mydb' (default: %(default)r)"
msgstr ""
"Plats för databas eller anslutningssträng, exempel 'project.db' eller "
"'postgresql://me:pw@localhost/mydb' (default: %(default)r)"

#: taguette/main.py:302
msgid "Set the file creation mask (umask) on systems that support it."
msgstr "Ställ in filskapande mask (umask) på system som stöder det."

#: taguette/main.py:306
msgid "Don't change umask on startup"
msgstr "Ändra inte umask vid start"

#: taguette/main.py:312
msgid "additional commands"
msgstr "ytterligare kommandon"

#: taguette/main.py:316
msgid "Manually trigger a database migration"
msgstr "Utlös en databasmigrering manuellt"

#: taguette/main.py:327
msgid "Print the default server configuration"
msgstr "Skriv ut standardkonfigurationen för server"

#: taguette/main.py:329
msgid "Output to this file rather than stdout"
msgstr "Utdata till den här filen istället för stdout"

#: taguette/main.py:335
msgid "Run in server mode, suitable for a multi-user deployment"
msgstr "Kör i serverläge, lämpligt för en distribution med flera användare"

#: taguette/main.py:337
msgid ""
"Configuration file for the server. The default configuration can be "
"generated using the `default-config` command"
msgstr ""
"Konfigurationsfil för servern. Standardkonfigurationen kan genereras med "
"kommandot `default-config`"

#: taguette/main.py:349
#, python-format
msgid "Invalid umask: %(arg)s"
msgstr "Ogiltig umask: %(arg)s"

#: taguette/main.py:373
#, python-format
msgid "Missing required configuration variable %(var)s"
msgstr "Nödvändig konfigurationsvariabel saknas %(var)s"

#: taguette/main.py:380
msgid "Invalid BASE_PATH"
msgstr "Ogiltig BASE_PATH"

#: taguette/main.py:454
#, python-format
msgid ""
"\n"
"    Taguette %(version)s is now running. You can connect to it using this"
" link:\n"
"\n"
"    %(url)s\n"
msgstr ""
"\n"
"    LibreQDA %(version)s är nu igång. Du kan ansluta via denna länk:\n"
"\n"
"    %(url)s\n"

#: taguette/database/__init__.py:136
msgid ""
"\n"
"    The database schema used by Taguette has changed! We will try to\n"
"    update your workspace automatically.\n"
msgstr ""
"\n"
"Databasschemat som används av LibreQDA har ändrats! Vi ska försöka\n"
"uppdatera din arbetsyta automatiskt.\n"

#: taguette/database/__init__.py:148
#, python-format
msgid ""
"\n"
"    A backup copy of your database file has been created. If the update\n"
"    goes horribly wrong, make sure to keep that file, and let us know:\n"
"    %(backup)s\n"
msgstr ""
"\n"
"   En säkerhetskopia av din databasfil har skapats. Om uppdateringen\n"
"   går fruktansvärt fel, se till att behålla den filen och låt oss veta:\n"
"   %(backup)s\n"

#: taguette/database/__init__.py:160
#, python-format
msgid ""
"\n"
"    The database schema used by Taguette has changed! Because you are not"
" using\n"
"    SQLite, we will not attempt a migration automatically; back up your "
"data and\n"
"    use `taguette --database=%(url)s migrate` if you want to proceed."
msgstr ""
"\n"
"Databasschemat som används av LibreQDA har ändrats! Eftersom du inte "
"använder SQLite, kommer vi           inte att försöka migrera "
"automatiskt; säkerhetskopiera dina data och använd `taguette "
"--database=%(url)s migrate` om du vill fortsätta."

