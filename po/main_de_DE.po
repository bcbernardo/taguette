#: taguette/main.py:454
#, python-format
msgid ""
"\n"
"    Taguette %(version)s is now running. You can connect to it using this"
" link:\n"
"\n"
"    %(url)s\n"
msgstr ""
"\n"
"    LibreQDA %(version)s läuft nun. Sie können sich damit verbinden indem"
" Sie folgenden Link verwenden:\n"
"\n"
"    %(url)s\n"

#: taguette/database/__init__.py:136
msgid ""
"\n"
"    The database schema used by Taguette has changed! We will try to\n"
"    update your workspace automatically.\n"
msgstr ""
"\n"
"Das von LibreQDA benutzte Datenbankschema wurde geändert! Wir werden "
"versuchen \n"
"Ihren Workspace automatisch zu aktualisieren.\n"

#: taguette/database/__init__.py:148
#, python-format
msgid ""
"\n"
"    A backup copy of your database file has been created. If the update\n"
"    goes horribly wrong, make sure to keep that file, and let us know:\n"
"    %(backup)s\n"
msgstr ""
"\n"
"    Eine Backup-Kopie Ihrer Datenbank wurde erstellt. Falls das Update \n"
"    furchtbar schief gehen sollte, stellen Sie sicher, dass Sie diese "
"Datei behalten, und informieren Sie uns bitte:\n"
"    %(backup)s\n"

#: taguette/database/__init__.py:160
#, python-format
msgid ""
"\n"
"    The database schema used by Taguette has changed! Because you are not"
" using\n"
"    SQLite, we will not attempt a migration automatically; back up your "
"data and\n"
"    use `taguette --database=%(url)s migrate` if you want to proceed."
msgstr ""
"\n"
"    Das von LibreQDA verwendete Datenbankschema wurde verändert. Da Sie "
"nicht \n"
"    SQLite benutzen, werden wir keine automatische Migration versuchen; "
"bitte sichern Sie Ihre Daten und \n"
"   verwenden Sie `taguette --database=%(url)s migrate`, falls Sie "
"fortfahren möchten."

